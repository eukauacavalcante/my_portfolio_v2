---
import Layout from "../../layouts/layout.astro";
import projects from "../../data/project";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import ImageCarousel from "@/components/ui/ImageCarousel.astro";

export const prerender = true;

export function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { slug } = Astro.params;
const projectFromProps = Astro.props.project;
const project = projectFromProps ?? projects.find((item) => item.slug === slug);

if (!project) {
    Astro.response.status = 404;
}

const pageTitle = project ? `${project.title}` : "Projeto nao encontrado";
---

<Layout pageTitle={pageTitle}>
    <section class="mx-auto w-full max-w-4xl px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
        {project ? (
            <article class="space-y-8">
                <div class="mb-8 sm:mb-12">
                    <Button href="/#projetos" variant="outline" direction="back" class="group">
                        Voltar
                    </Button>
                </div>
                <header class="space-y-4">
                    <div class="flex flex-row gap-3 justify-start items-center mb-4 text-xs sm:text-sm">
                        <span class="text-muted-foreground hover:text-primary transition-all uppercase">
                            <a href="/#projetos">Home</a>
                        </span>
                        <span class="text-muted-foreground">/</span>
                        <span class="text-primary font-semibold uppercase">{project.title}</span>
                    </div>
                    <div class="flex flex-row justify-between items-center">
                        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold uppercase">
                            {project.title}
                        </h1>
                        <span class="text-muted-foreground tracking-[1.17px]">{project.date}</span>
                    </div>
                    <p class="text-base sm:text-lg md:text-xl text-muted-foreground">
                        {project.phrase}
                    </p>
                    <div class="flex flex-row gap-2">
                        {project.tags.map((tag) => (
                            <span class="text-xs sm:text-sm text-muted-foreground uppercase bg-white/5 border border-white/10 px-2 py-0.5 rounded-[5px]">
                                {tag}
                            </span>
                        ))}
                    </div>
                </header>
                {project.images.length > 1 ? (
                    <ImageCarousel images={project.images} alt={project.title} />
                ) : project.images.length === 1 ? (
                    <div class="mx-auto overflow-hidden border border-border bg-card rounded-[5px]">
                        <img
                            src={project.images[0]}
                            alt={project.title}
                            width="1200"
                            height="675"
                            class="h-full w-full object-cover"
                            loading="lazy"
                        />
                    </div>
                ) : (
                    <div class="flex aspect-video items-center justify-center text-muted-foreground bg-card border border-[rgba(240,240,250,0.2)]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M17 12c0 .54-.1 1.05-.26 1.54L15 11.78A3.06 3.06 0 0 0 12.22 9l-1.76-1.74c.49-.16 1-.26 1.54-.26c2.76 0 5 2.24 5 5M9.88 4h4.24l1.83 2H20v10.8l1.88 1.88c.08-.21.12-.44.12-.68V6c0-1.11-.89-2-2-2h-3.17L15 2H9L7.18 4L8.6 5.4zm12.23 17.46l-1.27 1.27L18.11 20H4a2 2 0 0 1-2-2V6c0-.58.25-1.1.65-1.46L1.11 3l1.28-1.27zM9 12c0 1.66 1.34 3 3 3c.33 0 .65-.07.94-.17l-3.77-3.77c-.1.3-.17.61-.17.94m7.11 6l-1.66-1.66c-.73.41-1.56.66-2.45.66c-2.76 0-5-2.24-5-5c0-.89.25-1.72.66-2.45L4.11 6H4v12z"/>
                        </svg>
                    </div>
                )}
                <h2 class="text-2xl sm:text-3xl font-bold uppercase mb-4">Resumo</h2>
                <p class="text-base sm:text-lg md:text-xl leading-relaxed text-muted-foreground">
                    {project.resume}
                </p>
                {project.isPrivate && (
                    <Card size="full">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-3">
                                <h2 class="text-lg sm:text-xl font-semibold text-foreground uppercase">
                                    Projeto em Desenvolvimento
                                </h2>
                            </div>
                            <p class="text-muted-foreground text-sm sm:text-base leading-relaxed">
                                {project.privateDescription}
                            </p>
                        </div>
                    </Card>
                )}
                <div class="flex flex-row flex-wrap gap-4">
                    {project.github && (
                        <Button href={project.github} target="_blank" rel="noopener noreferrer">
                            Ver no GitHub
                        </Button>
                    )}
                    {project.linkedin && (
                        <Button variant="default" href={project.linkedin} target="_blank" rel="noopener noreferrer">
                            Ver no LinkedIn
                        </Button>
                    )}
                    {project.documentation && (
                        <Button variant="outline" href={project.documentation} target="_blank" rel="noopener noreferrer">
                            Ver Documentação
                        </Button>
                    )}
                    {project.website && (
                        <Button variant="outline" href={project.website} target="_blank" rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2m-5.15 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56M14.34 14H9.66c-.1-.66-.16-1.32-.16-2s.06-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2M12 19.96c-.83-1.2-1.5-2.53-1.91-3.96h3.82c-.41 1.43-1.08 2.76-1.91 3.96M8 8H5.08A7.92 7.92 0 0 1 9.4 4.44C8.8 5.55 8.35 6.75 8 8m-2.92 8H8c.35 1.25.8 2.45 1.4 3.56A8 8 0 0 1 5.08 16m-.82-2C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2M12 4.03c.83 1.2 1.5 2.54 1.91 3.97h-3.82c.41-1.43 1.08-2.77 1.91-3.97M18.92 8h-2.95a15.7 15.7 0 0 0-1.38-3.56c1.84.63 3.37 1.9 4.33 3.56M12 2C6.47 2 2 6.5 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2"/>
                            </svg>
                            Acessar Projeto
                        </Button>
                    )}
                </div>
                <hr class="border border-border">
                {project.functionalities && project.functionalities.length > 0 && (
                    <div class="space-y-6">
                        <h2 class="text-2xl sm:text-3xl font-bold uppercase mb-4">Funcionalidades</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            {project.functionalities.map((func) => (
                                <Card>
                                    <div class="flex flex-col items-start gap-4">
                                        <h4 class="text-sm sm:text-lg font-semibold text-foreground uppercase tracking-wider">
                                            {func.title}
                                        </h4>
                                        <p class="text-sm sm:text-base md:text-xl text-muted-foreground leading-relaxed">
                                            {func.description} 
                                        </p>
                                    </div>
                                </Card>
                            ))}
                        </div>
                    </div>
                )}
                {project.stack && (
                    <div class="space-y-4">
                        <h2 class="text-2xl sm:text-3xl font-bold uppercase mb-4">Tecnologias</h2>
                        {project.stack.frontend && project.stack.frontend.length > 0 && (
                            <div class="space-y-2">
                                <h3 class="text-sm sm:text-base md:text-lg font-semibold text-muted-foreground uppercase">Frontend</h3>
                                <div class="flex flex-wrap gap-2">
                                    {project.stack.frontend.map((tech) => (
                                        <span class="text-xs sm:text-sm text-muted-foreground uppercase bg-card border border-[rgba(240,240,250,0.2)] px-3 py-1.5 tracking-[1px] rounded-[5px]">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}
                        {project.stack.backend && project.stack.backend.length > 0 && (
                            <div class="space-y-2">
                                <h3 class="text-sm sm:text-base md:text-lg font-semibold text-muted-foreground uppercase">Backend</h3>
                                <div class="flex flex-wrap gap-2">
                                    {project.stack.backend.map((tech) => (
                                        <span class="text-xs sm:text-sm text-muted-foreground uppercase bg-card border border-[rgba(240,240,250,0.2)] px-3 py-1.5 tracking-[1px] rounded-[5px]">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}
                        {project.stack.database && project.stack.database.length > 0 && (
                            <div class="space-y-2">
                                <h3 class="text-sm sm:text-base md:text-lg font-semibold text-muted-foreground uppercase">Banco de Dados</h3>
                                <div class="flex flex-wrap gap-2">
                                    {project.stack.database.map((tech) => (
                                        <span class="text-xs sm:text-sm text-muted-foreground uppercase bg-card border border-[rgba(240,240,250,0.2)] px-3 py-1.5 tracking-[1px] rounded-[5px]">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>
                )}
                <div class="flex justify-center border-t border-border py-6">
                    <Button
                        variant="outline"
                        direction="back"
                        href="/#projetos"
                    >
                        Voltar
                    </Button>
                </div>
            </article>
        ) : (
            <article class="space-y-4 border border-border bg-card p-6">
                <h1 class="text-2xl font-bold sm:text-3xl">Projeto nao encontrado</h1>
                <p class="text-muted-foreground">
                    O projeto com slug <code>{slug}</code> nao existe ou nao esta publicado.
                </p>
                <Button
                    variant="outline"
                    direction="back"
                    href="/#projetos"
                >
                    Voltar
                </Button>
            </article>
        )}
    </section>
</Layout>
