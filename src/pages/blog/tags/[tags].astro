---
import BlogLayout from "@/layouts/blog/Layout.astro";
import Card from '@/components/ui/Card.astro';
import BlogCard from '@/components/blog/ui/BlogCard.astro';
import Button from '@/components/ui/Button.astro';

export const prerender = true;

export async function getStaticPaths() {
    const allPosts = Object.values(import.meta.glob('../posts/*.md', { eager: true })) as any[];
    const uniqueTags = [...new Set(allPosts.map((post: any) => post.frontmatter.tags ?? []).flat())];

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts
            .filter((post: any) => (post.frontmatter.tags ?? []).includes(tag))
            .sort((a: any, b: any) =>
                new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime()
            );
        return {
            params: { tags: tag },
            props: { posts: filteredPosts },
        };
    });
}

const { tags: tag } = Astro.params;
const { posts } = Astro.props;

// Group posts in pairs for the 2-per-row grid
const postPairs: any[][] = [];
for (let i = 0; i < posts.length; i += 2) {
    postPairs.push(posts.slice(i, i + 2));
}
---

<BlogLayout pageTitle={`#${tag}`}>
    <section class="min-h-svh w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
        <div class="mb-8 sm:mb-12">
            <Button href="/blog/tags" variant="outline" class="group">
                Todas as tags
            </Button>
        </div>
        <div class="flex flex-col gap-2 mb-10 sm:mb-14 lg:mb-16">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold leading-[1.1] tracking-tight">
                #{tag}
            </h1>
            <p class="text-base sm:text-lg md:text-xl text-muted-foreground mt-2">
                {posts.length} {posts.length === 1 ? 'post encontrado' : 'posts encontrados'}
            </p>
        </div>
        <h2 class="text-xs sm:text-sm text-muted-foreground tracking-[1.17px] uppercase flex items-center gap-3 mb-4 sm:mb-6">
            <span class="h-px w-16 sm:w-20 bg-border inline-block"></span>
            Navegando por #{tag}
        </h2>
        {postPairs.length > 0 ? (
            <div class="flex flex-col gap-4 sm:gap-6">
                {postPairs.map((pair) => (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                        {pair.map((post) => (
                            <BlogCard post={post} />
                        ))}
                    </div>
                ))}
            </div>
        ) : (
            <Card class="w-full py-16 flex flex-col items-center justify-center gap-3 text-center">
                <svg class="w-8 h-8 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                    <path fill="currentColor" d="m6 20l1-4H3l.5-2h4l1-4h-4L5 8h4l1-4h2l-1 4h4l1-4h2l-1 4h4l-.5 2h-4l-1 4h4l-.5 2h-4l-1 4h-2l1-4H9l-1 4zm3.5-6h4l1-4h-4z"/>
                </svg>
                <p class="text-muted-foreground text-sm">// Nenhum post com essa tag ainda.</p>
            </Card>
        )}
    </section>
</BlogLayout>
