---
import BlogLayout from "@/layouts/blog/Layout.astro";
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';

const allPosts = Object.values(import.meta.glob('../posts/*.md', { eager: true })) as any[];
const tagMap: Record<string, { count: number; latest: Date }> = {};

allPosts.forEach((post: any) => {
    const tags: string[] = post.frontmatter.tags ?? [];
    tags.forEach((tag) => {
        const postDate = new Date(post.frontmatter.pubDate);
        if (!tagMap[tag]) {
            tagMap[tag] = { count: 0, latest: postDate };
        }
        tagMap[tag].count += 1;
        if (postDate > tagMap[tag].latest) {
            tagMap[tag].latest = postDate;
        }
    });
});

const tags = Object.entries(tagMap).sort((a, b) => b[1].count - a[1].count);
const pageTitle = "Tags";
---

<BlogLayout title={pageTitle}>
    <section class="min-h-svh w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
        <div class="mb-8 sm:mb-12">
            <Button href="/blog" variant="outline" direction="back" class="group">
                Ver postagens
            </Button>
        </div>
        <div class="flex flex-col gap-2 mb-10 sm:mb-14 lg:mb-16">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold uppercase leading-[1.1] tracking-tight">
                Tags
            </h1>
            <p class="text-base sm:text-lg md:text-xl text-muted-foreground mt-2">
                {tags.length} {tags.length === 1 ? 'tema encontrado' : 'temas encontrados'} nos posts
            </p>
        </div>
        <h2 class="text-xs sm:text-sm text-muted-foreground tracking-[1.17px] uppercase flex items-center gap-3 mb-4 sm:mb-6">
            <span class="h-px w-16 sm:w-20 bg-border inline-block"></span>
            Explorando por temas
        </h2>
        {tags.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {tags.map(([tag, { count }]) => (
                    <a href={`/blog/tags/${tag}`} class="group">
                        <Card size="full" hover>
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-base sm:text-lg font-bold group-hover:text-foreground/80 transition-colors">
                                    #{tag}
                                </span>
                                <span class="text-xs text-primary bg-card border border-border px-2 py-1 shrink-0 tracking-[1px] rounded[5px]">
                                    {count} {count === 1 ? 'post' : 'posts'}
                                </span>
                            </div>
                        </Card>
                    </a>
                ))}
            </div>
        ) : (
            <Card size="full" class="py-16 flex flex-col items-center justify-center gap-3 text-center">
                <svg class="w-8 h-8 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
                    <path fill="currentColor" d="m6 20l1-4H3l.5-2h4l1-4h-4L5 8h4l1-4h2l-1 4h4l1-4h2l-1 4h4l-.5 2h-4l-1 4h4l-.5 2h-4l-1 4h-2l1-4H9l-1 4zm3.5-6h4l1-4h-4z"/>
                </svg>
                <p class="text-base sm:text-lg md:text-xl text-muted-foreground">Nenhuma tag encontrada ainda.</p>
            </Card>
        )}
    </section>
</BlogLayout>
