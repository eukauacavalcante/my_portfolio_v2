---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";

const allPosts = Object.values(import.meta.glob("../../pages/blog/posts/*.md", { eager: true })) as any[];
const sortedPosts = allPosts.sort(
    (a, b) => new Date(b.frontmatter?.publishedOn).getTime() - new Date(a.frontmatter?.publishedOn).getTime()
);

const featured = sortedPosts[0];
const featuredTitle = featured?.frontmatter?.title;
const featuredDescription = featured?.frontmatter?.description;
const featuredBanner = featured?.frontmatter?.image?.banner
    ? `/${featured.frontmatter.image.banner}`
    : null;
const featuredUrl = featured?.url;
---

<section class="mx-auto min-h-svh px-4 sm:px-6 lg:px-0 w-full max-w-250 flex justify-center items-center">
    <Card
        size="full"
        hover={false}
        class="relative my-20 overflow-hidden p-6 sm:p-10 lg:p-12"
    >
        <div class="relative z-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
            <div class="flex w-full flex-col items-start justify-between gap-5 lg:col-span-5">
                <div class="space-y-8">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold uppercase leading-[1.1] tracking-tight">
                        Blog Pessoal
                    </h2>
                    <p class="text-base md:text-xl text-muted-foreground leading-relaxed max-w-xl">
                        Compartilho minha jornada acadêmica em <span class="text-foreground font-medium">ADS</span>, tutoriais técnicos e reflexões sobre a evolução da tecnologia.
                    </p>
                </div>
                <Button
                    href="/blog"
                    class="w-full p-2 sm:p-4 tracking-[1.17px]"
                >
                    Acessar Blog
                </Button>
            </div>
            <div class="flex w-full items-center lg:col-span-7">
                {featured && (
                    <a
                        href={featuredUrl}
                        class="w-full overflow-hidden border border-border hover:border-white bg-background rounded-[5px] transition-colors duration-300"
                    >
                        {featuredBanner && (
                            <div class="aspect-video w-full overflow-hidden">
                                <img
                                    src={featuredBanner}
                                    alt={featuredTitle}
                                    width="1200"
                                    height="675"
                                    class="h-full w-full object-cover"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </div>
                        )}
                        <div class="space-y-3 p-4 sm:p-5">
                            <span class="text-[10px] sm:text-xs font-semibold bg-foreground text-primary-foreground px-2 py-0.5 uppercase rounded-[5px]">
                                Mais recente
                            </span>
                            <h3 class="text-lg font-bold leading-snug text-primary sm:text-xl line-clamp-2 uppercase">
                                {featuredTitle}
                            </h3>
                            <p class="text-sm md:text-base leading-relaxed text-muted-foreground line-clamp-3">
                                {featuredDescription}
                            </p>
                        </div>
                    </a>
                )}
            </div>
        </div>
    </Card>
</section>
