---
import services from "../../data/services";
---

<section
    id="servicos"
    class="relative isolate min-h-svh flex flex-col justify-center items-center w-full px-4 sm:px-6 lg:px-8 py-24 lg:py-32 overflow-hidden"
>
    <picture class="absolute inset-0 -z-10 block h-full w-full">
        <source 
            media="(min-width: 560px)" 
            srcset="landing/earthset.webp"
        />
        <img
            src="landing/earthset-mobile.webp"
            alt="Vista do 'Earthset' (pôr da Terra) capturada da órbita lunar. Em primeiro plano, a superfície cinzenta e rugosa da Lua com crateras em destaque. Ao fundo, a Terra aparece parcialmente iluminada em tons de azul e branco."
            class="h-full w-full object-cover object-center"
            loading="lazy"
            decoding="async"
        />
        <div class="absolute inset-0 bg-black/60"></div>
    </picture>
    <div class="px-4 sm:px-6 lg:px-8 absolute top-12 right-4 sm:right-6 lg:right-16 flex flex-col items-start max-w-xl text-left">
        <h2 class="text-3xl md:text-4xl font-bold uppercase tracking-tight">Serviços</h2>
        <p class="text-lg md:text-xl text-muted-foreground mt-2">
            Soluções especializadas elaboradas com precisão e inovação.
        </p>
    </div>
    <div class="w-full max-w-7xl mx-auto mt-32 lg:mt-0">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 justify-items-center">
            {services.map((service) => (
                <div class="flex flex-col items-start justify-center w-full border border-border bg-card p-8 rounded-[5px]">
                    <div class="flex flex-col items-start gap-4">
                        <h4 class="text-2xl font-semibold text-foreground uppercase tracking-wider">
                            {service.title}
                        </h4>
                        <p class="text-base md:text-xl text-muted-foreground leading-relaxed">
                            {service.description} 
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
