---
import Button from "../ui/Button.astro";
---

<section
  id="hero"
  class="relative w-screen min-h-svh flex flex-col justify-center overflow-hidden"
>
  <video
    class="hidden md:block absolute inset-0 w-full h-full object-cover z-0"
    autoplay
    muted
    loop
    playsinline
    poster="/landing/mars_static.webp"
    aria-hidden="true"
  >
    <source src="/landing/mars_rotation.webm" type="video/webm" />
  </video>
  <video
    class="md:hidden absolute top-0 right-0 h-full w-auto max-w-none translate-x-1/2 z-0 object-cover"
    autoplay
    muted
    loop
    playsinline
    poster="/landing/mars_static_mobile.webp"
    aria-hidden="true"
  >
    <source src="/landing/mars_rotation_mobile.webm" type="video/webm" />
  </video>
  <div
    class="absolute inset-0 z-10 bg-linear-to-r from-background/60 via-background/30 to-transparent md:hidden"
    aria-hidden="true"
  ></div>
  <div class="relative z-10 w-full max-w-350 px-6 md:px-12 lg:px-20 pt-90 md:pt-60">
    <div class="w-full md:w-1/2 flex flex-col gap-4 sm:gap-8">
      <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold uppercase">Kauã Cavalcante</h1>
      <p class="text-base md:text-xl text-muted-foreground">
        Desenvolvedor Full Stack especializado em criar soluções escaláveis,
        seguras e modernas com foco em APIs robustas e experiência no
        desenvolvimento de sistemas end-to-end.
      </p>
      <div class="flex flex-row gap-4 md:gap-8">
        <Button href="#sobre-mim">Conhecer</Button>
        <Button href="#contato" variant="outline">Contato</Button>
      </div>
      <div class="flex flex-row items-center gap-2 sm:gap-4 mt-12 sm:mt-24">
        <a
          href="https://github.com/eukauacavalcante/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M7.024 2.31a9 9 0 0 1 2.125 1.046A11.4 11.4 0 0 1 12 3c.993 0 1.951.124 2.849.355a9 9 0 0 1 2.124-1.045c.697-.237 1.69-.621 2.28.032c.4.444.5 1.188.571 1.756c.08.634.099 1.46-.111 2.28C20.516 7.415 21 8.652 21 10c0 2.042-1.106 3.815-2.743 5.043a9.5 9.5 0 0 1-2.59 1.356c.214.49.333 1.032.333 1.601v3a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-.991c-.955.117-1.756.013-2.437-.276c-.712-.302-1.208-.77-1.581-1.218c-.354-.424-.74-1.38-1.298-1.566a1 1 0 0 1 .632-1.898c.666.222 1.1.702 1.397 1.088c.48.62.87 1.43 1.63 1.753c.313.133.772.22 1.49.122L8 17.98a4 4 0 0 1 .333-1.581a9.5 9.5 0 0 1-2.59-1.356C4.106 13.815 3 12.043 3 10c0-1.346.483-2.582 1.284-3.618c-.21-.82-.192-1.648-.112-2.283l.005-.038c.073-.582.158-1.267.566-1.719c.59-.653 1.584-.268 2.28-.031Z"/></g></svg>
        </a>
        <a
          href="https://linkedin.com/in/eukauacavalcante"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24"><path fill="currentColor" d="M6.94 5a2 2 0 1 1-4-.002a2 2 0 0 1 4 .002M7 8.48H3V21h4zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91z"/></svg>
        </a>
        <a
          href="https://x.com/ikauacavalcante"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          title="Twitter"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 14 14"><g fill="none"><g clip-path="url(#SVGG1Ot4cAD)"><path fill="currentColor" d="M11.025.656h2.147L8.482 6.03L14 13.344H9.68L6.294 8.909l-3.87 4.435H.275l5.016-5.75L0 .657h4.43L7.486 4.71zm-.755 11.4h1.19L3.78 1.877H2.504z"/></g><defs><clipPath id="SVGG1Ot4cAD"><path fill="#fff" d="M0 0h14v14H0z"/></clipPath></defs></g></svg>
        </a>
      </div>
      <div class="flex sm:hidden justify-center items-center mt-5 text-muted-foreground animate-bounce">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m7 10l5 5l5-5" stroke-width="1"/></svg>
        <span class="text-xs uppercase">Deslize</span>
      </div>
    </div>
  </div>
</section>
