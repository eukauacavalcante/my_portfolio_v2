---
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import Project from "../../data/project.ts";
---

<section
    id="projetos"
    class="relative isolate w-full min-h-svh flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 pt-24 lg:pt-32 pb-24 lg:pb-32 overflow-hidden"
>
    <div class="absolute inset-0 -z-10 bg-black"> 
        <picture class="w-full h-full">
            <source srcset="landing/mars_mobile.webp" media="(max-width: 768px)" />
            <img
                src="landing/mars.webp"
                alt="Fotografia em close-up da curvatura do planeta Marte, mostrando sua superfície vermelha e repleta de crateras, iluminada por uma luz lateral dramática contra o vazio negro do espaço."
                class="h-full w-full object-cover object-top" 
                loading="lazy"
                decoding="async"
            />
        </picture>
        <div class="absolute inset-0 bg-black/66 sm:bg-black/60 lg:bg-black/52"></div>
        <div class="absolute inset-0 bg-linear-to-b from-black/20 via-black/10 to-black/40"></div>
    </div>
    <div class="px-4 sm:px-6 lg:px-8 absolute top-12 right-4 sm:right-6 lg:right-16 z-10 flex flex-col items-start max-w-xl text-left">
        <h2 class="text-3xl md:text-4xl font-bold uppercase tracking-tight">Projetos</h2>
        <p class="text-lg md:text-xl text-muted-foreground mt-2">
            Projetos onde coloquei a mão na massa e desenvolvi aplicações modernas.
        </p>
    </div>
    <div class="relative z-10 w-full max-w-7xl mx-auto mt-32 lg:mt-0">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
            { Project.map((project, index) => (
                <Card
                    size="full"
                    hover={false}
                    class="flex flex-col sm:flex-row w-full p-0"
                >
                    <div class="w-full sm:w-1/2 h-48 sm:h-auto shrink-0 bg-card border-b sm:border-b-0 sm:border-r border-border overflow-hidden">
                        {project.logo ? (
                            <img
                                src={project.logo}
                                alt={project.title}
                                loading="lazy"
                                class="w-full h-full object-cover"
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center text-muted-foreground">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24">
                                    <path fill="currentColor" d="M17 12c0 .54-.1 1.05-.26 1.54L15 11.78A3.06 3.06 0 0 0 12.22 9l-1.76-1.74c.49-.16 1-.26 1.54-.26c2.76 0 5 2.24 5 5M9.88 4h4.24l1.83 2H20v10.8l1.88 1.88c.08-.21.12-.44.12-.68V6c0-1.11-.89-2-2-2h-3.17L15 2H9L7.18 4L8.6 5.4zm12.23 17.46l-1.27 1.27L18.11 20H4a2 2 0 0 1-2-2V6c0-.58.25-1.1.65-1.46L1.11 3l1.28-1.27zM9 12c0 1.66 1.34 3 3 3c.33 0 .65-.07.94-.17l-3.77-3.77c-.1.3-.17.61-.17.94m7.11 6l-1.66-1.66c-.73.41-1.56.66-2.45.66c-2.76 0-5-2.24-5-5c0-.89.25-1.72.66-2.45L4.11 6H4v12z"/>
                                </svg>
                            </div>
                        )}
                    </div>
                    <div class="w-full sm:w-1/2 flex flex-col gap-4 justify-between p-5">
                        <div class="w-full flex justify-between items-center">
                            <span class="text-sm text-muted-foreground uppercase tracking-widest">{project.date}</span>
                            <span class="w-7 h-7 flex items-center justify-center border border-border text-sm text-muted-foreground rounded-[5px]">
                                0{index + 1}
                            </span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <h4 class="text-xl sm:text-2xl font-bold uppercase text-foreground">{project.title}</h4>
                            <p class="text-base md:text-xl text-muted-foreground line-clamp-2">{project.phrase}</p>
                        </div>
                        <div class="flex flex-wrap gap-1.5">
                            {project.tags.slice(0, 3).map((tag) => (
                                <span class="text-xs text-muted-foreground uppercase bg-white/5 border border-white/10 px-2 py-0.5 rounded-[5px]">
                                    {tag}
                                </span>
                            ))}
                        </div>
                        <Button href={`/projetos/${project.slug}`} size="full" class="text-sm py-2 mt-2">
                            Ver Projeto
                        </Button>
                    </div>
                </Card>
            ))}
        </div>
    </div>
</section>
