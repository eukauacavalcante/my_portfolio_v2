---
import FormContact from "../ui/FormContact.astro";
---

<section id="contato" class="max-w-7xl min-h-svh flex justify-center items-center w-full px-4 sm:px-6 lg:px-0">
    <div class="w-full max-w-7xl flex flex-col lg:flex-row gap-12 lg:gap-16 justify-between items-center lg:items-start">
        <div class="w-full lg:w-1/2 flex flex-col gap-3 sm:gap-6 justify-center items-start">
            <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight uppercase">
                Vamos conversar por email?
            </h1>
            <span class="text-muted-foreground text-lg md:text-xl leading-relaxed">
                Escolha o contexto, descreva o que você precisa<br class="hidden sm:block" />
                e abra um rascunho pronto no seu aplicativo de email.
            </span>
            <div class="w-full hidden md:flex justify-center items-center mt-4">
                <img
                    src="landing/world.svg"
                    class="w-4/5 sm:w-2/3 lg:w-full max-w-sm lg:max-w-none opacity-90" 
                    alt="Mapa mundi estilizado representando o contato global"
                    width={400}
                    height={300}
                />
            </div>
        </div>
        <div class="w-full lg:w-1/2">
            <FormContact />
        </div>
    </div>
</section>
