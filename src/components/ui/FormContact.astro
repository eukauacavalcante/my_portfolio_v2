---
import Button from "./Button.astro";

const contactEmail = "eukauasilvacavalcante@gmail.com";
const fallbackSubject = "Contato pelo portfólio";
const fallbackBody = [
  "Olá Kauã,",
  "",
  "Encontrei seu portfólio e gostaria de conversar sobre:",
  "[Descreva aqui o contexto do seu contato.]",
  "",
  "Abraço,",
  "[Seu nome]",
].join("\n");
---

<div class="form-contact-wrapper" data-contact-email={contactEmail}>
  <form id="contact-mailto-form" class="form-contact-form">
    <div class="form-contact-checkboxes">
      <span class="form-contact-checkboxes-title">Qual é o contexto?</span>
      <div class="form-contact-checkboxes-group">
        <label class="checkbox-label">
          <input
            type="radio"
            class="checkbox-input"
            value="Projeto"
            name="reason"
            checked
          />
          Projeto
        </label>
        <label class="checkbox-label">
          <input
            type="radio"
            class="checkbox-input"
            value="Parceria"
            name="reason"
          />
          Parceria
        </label>
        <label class="checkbox-label">
          <input
            type="radio"
            class="checkbox-input"
            value="Outro"
            name="reason"
          />
          Outro
        </label>
      </div>
    </div>

    <div class="form-contact-divider"></div>

    <div class="form-contact-row">
      <div class="form-contact-field">
        <label for="contact-name" class="label-base">Seu nome</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          placeholder="Como você gostaria de se apresentar"
          class="input-base"
        />
      </div>
      <div class="form-contact-field">
        <label for="contact-company" class="label-base">Empresa ou projeto</label>
        <input
          id="contact-company"
          name="company"
          type="text"
          placeholder="Nome da marca, produto ou equipe"
          class="input-base"
        />
      </div>
    </div>

    <div class="form-contact-field">
      <label for="contact-message" class="label-base">Resumo do contato</label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        placeholder="Conte o objetivo, o prazo e qualquer detalhe importante para eu entender o contexto."
        class="input-base resize-none"></textarea>
    </div>

    <div class="form-contact-actions">
      <Button
        id="mailto-link"
        href={`mailto:${contactEmail}?subject=${encodeURIComponent(fallbackSubject)}&body=${encodeURIComponent(fallbackBody)}`}
        size="full"
        class="sm:w-auto sm:flex-1"
      >
        Abrir email
      </Button>
      <button
        type="button"
        id="copy-email-btn"
        class="form-contact-secondary-action"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="mr-2" width="15" height="15" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></g></svg>
        Copiar email
      </button>
    </div>

    <p id="contact-feedback" class="text-sm sm:text-base leading-relaxed" aria-live="polite">
      Se preferir, copie o endereço e envie a mensagem pelo serviço de email da sua escolha.
    </p>
  </form>
</div>

<script>
  function initContactForm() {
    const wrapper = document.querySelector(
      ".form-contact-wrapper",
    ) as HTMLDivElement | null;
    const form = document.getElementById(
      "contact-mailto-form",
    ) as HTMLFormElement | null;
    const mailtoLink = document.getElementById(
      "mailto-link",
    ) as HTMLAnchorElement | null;
    const copyEmailBtn = document.getElementById(
      "copy-email-btn",
    ) as HTMLButtonElement | null;
    const feedback = document.getElementById("contact-feedback");
    const contactEmail = wrapper?.dataset.contactEmail;

    const subjectByReason: Record<string, string> = {
      Projeto: "Novo projeto pelo portfólio",
      Parceria: "Proposta de parceria pelo portfólio",
      Outro: "Contato pelo portfólio",
    };

    function buildDraft() {
      if (!form || !mailtoLink) return;

      const data = new FormData(form);
      const reason = ((data.get("reason") as string) || "Projeto").trim();
      const name = ((data.get("name") as string) || "").trim();
      const company = ((data.get("company") as string) || "").trim();
      const message = ((data.get("message") as string) || "").trim();

      const subject = subjectByReason[reason] || subjectByReason.Outro;
      const bodyLines = [
        "Olá Kauã,",
        "",
        `Motivo do contato: ${reason}`,
        company ? `Empresa ou projeto: ${company}` : "",
        "",
        "Contexto:",
        message || "[Descreva aqui o objetivo, o prazo e os detalhes principais.]",
        "",
        "Abraço,",
        name || "[Seu nome]",
      ];

      const href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join("\n"))}`;
      mailtoLink.href = href;
    }

    async function copyEmail() {
      if (!feedback) return;

      try {
        await navigator.clipboard.writeText(contactEmail || "");
        feedback.textContent =
          "Email copiado. Agora é só colar no seu cliente de email.";
        feedback.classList.add("text-green-500");
      } catch {
        feedback.textContent =
          `Não foi possível copiar automaticamente. Use este endereço: ${contactEmail}`;
        feedback.classList.add("text-red-500");
      }
    }

    form?.addEventListener("input", buildDraft);
    form?.addEventListener("change", buildDraft);
    copyEmailBtn?.addEventListener("click", copyEmail);

    buildDraft();
  }

  if (document.readyState === "complete") {
    initContactForm();
  } else {
    window.addEventListener("load", initContactForm, { once: true });
  }
</script>
