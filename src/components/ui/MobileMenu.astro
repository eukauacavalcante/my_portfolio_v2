---
import Button from "../ui/Button.astro";

export interface NavLink {
    label: string;
    href: string;
}

export interface Props {
    links: readonly NavLink[];
    /**
     * Quando `true`, renderiza apenas o dropdown flutuante (fora do fluxo).
     * Quando `false` (padrão), renderiza apenas o botão hamburguer (dentro da pill).
    */
    dropdownOnly?: boolean;
}

const { links, dropdownOnly = false } = Astro.props;
---

{/* ── Botão hamburguer ──────────────────────────────────── */}
{!dropdownOnly && (
    <button
        id="mobile-menu-btn"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="
            md:hidden
            flex items-center justify-center
            w-9 h-9
            text-foreground
            hover:bg-accent
            transition-colors duration-200
            rounded-sm
            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring
        "
    >
        <!-- Ícone hamburguer -->
        <svg
            id="icon-open"
            xmlns="http://www.w3.org/2000/svg"
            width="20" height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
        </svg>

        <!-- Ícone fechar -->
        <svg
            id="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            width="20" height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="hidden"
        >
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
    </button>
)}

{/* ── Dropdown do menu ──────────────────────────────────── */}
{dropdownOnly && (
    <div
        id="mobile-menu"
        role="dialog"
        aria-label="Menu de navegação"
        aria-modal="false"
        class="mobile-menu md:hidden"
    >
        <nav aria-label="Links principais">
            <ul class="flex flex-col gap-4 text-sm text-muted-foreground tracking-[1.17px] uppercase">
                {links.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            class="px-3 py-2.5"
                        >
                            {label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <div class="mt-3 pt-3 border-t border-border">
            <Button
                href="https://www.linkedin.com/in/eukauacavalcante"
                target="_blank"
                rel="noopener noreferrer"
                variant="default"
                class="w-full"
            >
                Conecte-se
            </Button>
        </div>
    </div>

    <style>
        /* ── Dropdown ─────────────────────────────────────────────── */
        .mobile-menu {
            position: absolute;
            left: 1rem;
            right: 1rem;
            top: calc(100% + 4px);
            z-index: 40;
            padding: 0.625rem;
            background-color: color-mix(in srgb, var(--color-background) 90%, transparent);
            border: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
            border-radius: 6px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow:
                0 4px 6px -1px rgba(0, 0, 0, 0.4),
                0 2px 4px -2px rgba(0, 0, 0, 0.3);
            opacity: 0;
            transform: translateY(-6px) scale(0.98);
            transform-origin: top center;
            visibility: hidden;
            pointer-events: none;
            transition:
                opacity 180ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0ms linear 180ms;
        }

        .mobile-menu.is-open {
            opacity: 1;
            transform: translateY(0) scale(1);
            visibility: visible;
            pointer-events: auto;
            transition:
                opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0ms linear 0ms;
        }

        @media (min-width: 640px) {
            .mobile-menu {
                left: 1.5rem;
                right: 1.5rem;
            }
        }

        /* ── Overlay ──────────────────────────────────────────────── */
        #mobile-menu-overlay {
            position: fixed;
            inset: 0;
            z-index: 39;
            background-color: rgba(0, 0, 0, 0.55);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition:
                opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0ms linear 200ms;
        }

        #mobile-menu-overlay.is-open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transition:
                opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0ms linear 0ms;
        }
    </style>

    <script>
        const btn = document.getElementById("mobile-menu-btn") as HTMLButtonElement | null;
        const menu = document.getElementById("mobile-menu") as HTMLElement | null;
        const iconOpen = document.getElementById("icon-open");
        const iconClose = document.getElementById("icon-close");

        /* Cria o overlay uma única vez */
        let overlay = document.getElementById("mobile-menu-overlay") as HTMLElement | null;
        if (!overlay) {
            overlay = document.createElement("div");
            overlay.id = "mobile-menu-overlay";
            document.body.appendChild(overlay);
        }

        function openMenu() {
            menu?.classList.add("is-open");
            overlay?.classList.add("is-open");
            iconOpen?.classList.add("hidden");
            iconClose?.classList.remove("hidden");
            btn?.setAttribute("aria-expanded", "true");
            document.body.style.overflow = "hidden";
        }

        function closeMenu() {
            menu?.classList.remove("is-open");
            overlay?.classList.remove("is-open");
            iconOpen?.classList.remove("hidden");
            iconClose?.classList.add("hidden");
            btn?.setAttribute("aria-expanded", "false");
            document.body.style.overflow = "";
        }

        btn?.addEventListener("click", () => {
            btn.getAttribute("aria-expanded") === "true" ? closeMenu() : openMenu();
        });

        overlay.addEventListener("click", closeMenu);

        menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", closeMenu));

        document.addEventListener("keydown", (e: KeyboardEvent) => {
            if (e.key === "Escape") closeMenu();
        });
    </script>
)}
