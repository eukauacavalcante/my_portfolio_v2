<button aria-label="Alternar tema" title="Alterar tema" class="flex items-center border border-border cursor-pointer" id="theme-toggle">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none">
        <g id="sun" class="theme-sun">
            <circle cx="12" cy="12" r="5" fill="currentColor" />
            <g stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="3" />
                <line x1="12" y1="21" x2="12" y2="23" />
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                <line x1="1" y1="12" x2="3" y2="12" />
                <line x1="21" y1="12" x2="23" y2="12" />
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </g>
        </g>
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80"><g fill="currentColor"></svg>
        <g id="moon" class="theme-moon">
            <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" fill="currentColor" />
        </g>
    </svg>
</button>

<style>
    button#theme-toggle {
        border: 0;
        background: none;
    }
    .theme-sun { display: none; color: #ffffff; }
    .theme-moon { display: block; color: #000000; }
    :global(.dark) .theme-sun { display: block; }
    :global(.dark) .theme-moon { display: none; }
</style>

<script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const el = document.documentElement;
        el.classList.toggle('dark');
        localStorage.setItem('theme', el.classList.contains('dark') ? 'dark' : 'light');
    });
</script>
