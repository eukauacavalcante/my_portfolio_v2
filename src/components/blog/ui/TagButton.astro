---
const tag = Astro.props.tag;
---

<a
    href={`/blog/tags/${tag}`}
    class="text-xs sm:text-sm md:text-base text-muted-foreground border border-border bg-card px-2 py-0.5 tracking-[1px] hover:border-[rgba(240,240,250,0.65)] hover:text-foreground transition-colors rounded-[5px]"
>
    #{tag}
</a>
