---
import Card from "./Card.astro";
import Button from "@/components/ui/Button.astro";
import TagButton from "./TagButton.astro";
import { Image } from "astro:assets";

const post = Astro.props.post;
---

{!post?.frontmatter ? (
    <Card size="full" class="p-4 text-sm text-muted-foreground font-mono">
        // Post invalido
    </Card>
) : (

<Card
    size="full"
    hover
    class="flex flex-col overflow-hidden p-0 group"
>
    {post.frontmatter.image?.banner && (
        <div class="w-full h-50 md:h-58 lg:h-78 overflow-hidden shrink-0">
            { post.frontmatter.image?.banner ? (
                <Image
                    src={"/" + post.frontmatter.image.banner}
                    alt={post.frontmatter.image.alt ?? post.frontmatter.title}
                    width={800}
                    height={450}
                    class="w-full h-full object-cover"
                />
            ) : (
                <div class="w-full h-full flex items-center justify-center text-muted-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M17 12c0 .54-.1 1.05-.26 1.54L15 11.78A3.06 3.06 0 0 0 12.22 9l-1.76-1.74c.49-.16 1-.26 1.54-.26c2.76 0 5 2.24 5 5M9.88 4h4.24l1.83 2H20v10.8l1.88 1.88c.08-.21.12-.44.12-.68V6c0-1.11-.89-2-2-2h-3.17L15 2H9L7.18 4L8.6 5.4zm12.23 17.46l-1.27 1.27L18.11 20H4a2 2 0 0 1-2-2V6c0-.58.25-1.1.65-1.46L1.11 3l1.28-1.27zM9 12c0 1.66 1.34 3 3 3c.33 0 .65-.07.94-.17l-3.77-3.77c-.1.3-.17.61-.17.94m7.11 6l-1.66-1.66c-.73.41-1.56.66-2.45.66c-2.76 0-5-2.24-5-5c0-.89.25-1.72.66-2.45L4.11 6H4v12z"/>
                    </svg>
                </div>
            )}
        </div>
    )}
    <div class="flex flex-col flex-1 p-4 sm:p-5 md:p-4 lg:p-5 gap-3 md:gap-2.5">
        <h3 class="text-lg md:text-xl lg:text-3xl font-bold leading-snug transition-colors duration-300 line-clamp-2 group-hover:text-foreground uppercase">
            {post.frontmatter.title}
        </h3>
        <p class="text-muted-foreground text-base lg:text-xl line-clamp-4 flex-1">
            {post.frontmatter.description}
        </p>
    </div>
    <div class="flex items-center justify-between p-4 md:p-3.5 lg:p-4 gap-4 md:gap-3 border-t border-border mt-auto">
        <div class="flex flex-col items-start gap-2 md:gap-1.5">
            <span class="text-sm sm:text-base text-muted-foreground flex items-center gap-2.5 md:gap-2 font-medium whitespace-nowrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="md:w-4 md:h-4 lg:w-5 lg:h-5">
                    <path fill="currentColor" d="M19 19H5V8h14m-3-7v2H8V1H6v2H5c-1.11 0-2 .89-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-1V1m-1 11h-5v5h5z"/>
                </svg>
                {new Date(post.frontmatter.publishedOn).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
            </span>
            <span class="text-sm sm:text-base text-muted-foreground flex items-center gap-2.5 md:gap-2 font-medium whitespace-nowrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="md:w-4 md:h-4 lg:w-5 lg:h-5">
                    <path fill="currentColor" d="M12 2A10 10 0 0 0 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2m4.2 14.2L11 13V7h1.5v5.2l4.5 2.7z"/>
                </svg>
                {post.frontmatter.readingTime} min de leitura
            </span>
        </div>
        <Button href={post.url} class="shrink-0 group/btn md:px-4 md:py-2 md:text-sm lg:px-5 lg:py-2.5">
            <span>Ler artigo</span>
        </Button>
    </div>
</Card>

)}
