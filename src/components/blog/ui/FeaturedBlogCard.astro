---
import Card from "./Card.astro";
import Button from "@/components/ui/Button.astro";
import TagButton from "./TagButton.astro";
import { Image } from "astro:assets";

const featured = Astro.props.featured;
---

{!featured?.frontmatter ? (
    <Card size="full" class="p-4 text-sm text-muted-foreground">
        Post em destaque inválido
    </Card>
) : (
<Card
    size="full"
    hover
    class="flex flex-col md:flex-row h-auto min-h-fit p-0 overflow-hidden"
>
    {featured.frontmatter.image?.banner && (
        <div class="w-full md:w-[56%] h-50 sm:h-80 md:h-auto overflow-hidden shrink-0">
            <Image
                src={"/" + featured.frontmatter.image.banner}
                alt={featured.frontmatter.image.alt ?? featured.frontmatter.title}
                width={800}
                height={450}
                class="w-full h-full object-cover"
            />
        </div>
    )}
    <div class="flex flex-col justify-between flex-1 border-t md:border-t-0 md:border-l border-border bg-card">
        <div class="flex flex-col gap-4 sm:gap-6 md:gap-4 p-4 sm:p-6 md:p-5 lg:p-6">
            <div class="flex flex-col gap-2 sm:gap-6 md:gap-4">
                <div class="flex">
                    <span class="text-[10px] sm:text-xs md:text-sm font-bold bg-foreground text-primary-foreground px-2.5 py-1 tracking-widest rounded-[5px] uppercase">
                        Mais recente
                    </span>
                </div>
                <h3 class="text-xl sm:text-3xl md:text-2xl lg:text-3xl font-bold leading-tight transition-colors duration-300 group-hover:text-primary uppercase">
                    {featured.frontmatter.title}
                </h3>
                <p class="text-muted-foreground text-base lg:text-xl line-clamp-4">
                    {featured.frontmatter.description}
                </p>
            </div>
        </div>
        <div class="flex flex-row items-center justify-between sm:gap-6 md:gap-4 p-4 sm:p-6 md:p-5 lg:p-6 mt-auto border-t border-border">
            <div class="flex flex-col items-start gap-2 md:gap-1.5">
                <span class="text-sm sm:text-base text-muted-foreground flex items-center gap-2.5 md:gap-2 font-medium whitespace-nowrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="shrink-0 text-primary md:w-4 md:h-4 lg:w-4.5 lg:h-4.5">
                        <path fill="currentColor" d="M19 19H5V8h14m-3-7v2H8V1H6v2H5c-1.11 0-2 .89-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-1V1m-1 11h-5v5h5z"/>
                    </svg>
                    {new Date(featured.frontmatter.publishedOn).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
                </span>
                <span class="text-sm sm:text-base text-muted-foreground flex items-center gap-2.5 md:gap-2 font-medium whitespace-nowrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="shrink-0 text-primary md:w-4 md:h-4 lg:w-4.5 lg:h-4.5">
                        <path fill="currentColor" d="M12 2A10 10 0 0 0 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2m4.2 14.2L11 13V7h1.5v5.2l4.5 2.7z"/>
                    </svg>
                    {featured.frontmatter.readingTime} min de leitura
                </span>
            </div>
            <Button href={featured.url}>
                <span>Ler artigo completo</span>
            </Button>
        </div>
    </div>
</Card>
)}
