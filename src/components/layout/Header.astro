---
import Button from "../ui/Button.astro";
import MobileMenu from "../ui/MobileMenu.astro";
import navLinks from "../../data/nav-links";
---

<header class="fixed top-0 z-50 w-full">
    <div class="flex items-center justify-between px-4 py-3 sm:py-2 sm:px-6 lg:px-14 bg-background/5 backdrop-blur-2xl">
        <a
            href="/"
            class="text-lg md:text-xl font-bold tracking-[0.96px] uppercase shrink-0"
            aria-label="Página inicial"
        >
            KC
        </a>
        <nav class="hidden md:flex flex-1 ml-8 lg:ml-12" aria-label="Navegação principal">
            <ul class="flex items-center gap-4 lg:gap-8 text-sm text-muted-foreground tracking-[1.17px] uppercase">
                {navLinks.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            class="hover:text-foreground transition-colors duration-200"
                        >
                            {label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
        <div class="flex items-center gap-3 ml-auto md:ml-4">
            <div class="hidden md:block">
                <Button
                    href="https://www.linkedin.com/in/eukauacavalcante"
                    target="_blank"
                    rel="noopener noreferrer"
                    size="sm"
                >
                    Conecte-se
                </Button>
            </div>
            <MobileMenu links={navLinks} />
        </div>
    </div>
    <MobileMenu links={navLinks} dropdownOnly />
</header>
