---
import '../styles/global.css';
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Head from "../components/metadata/Head.astro";

const { 
    pageTitle,
    pageDescription,
    ogImage,
    ogImageAlt,
    canonicalUrl,
    class: className
} = Astro.props;
---

<html lang="pt-BR">
    <head>
        <Head
            title={pageTitle}
            description={pageDescription}
            ogImage={ogImage}
            ogImageAlt={ogImageAlt}
            canonicalUrl={canonicalUrl ?? Astro.url.href}
        />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    </head>
    <body class=`${className} bg-background text-foreground selection:bg-foreground selection:text-primary-foreground overflow-x-hidden`>
        <Header />
        <main class="w-full">
            <slot />
        </main>
        <Footer />
    </body>
</html>
