---
import '../styles/global.css';
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Head from "../components/metadata/Head.astro";

const { 
    pageTitle,
    pageDescription,
    ogImage,
    ogImageAlt,
    canonicalUrl,
    class: className
} = Astro.props;
---

<html lang="pt-BR">
    <head>
        <Head
            title={pageTitle}
            description={pageDescription}
            ogImage={ogImage}
            ogImageAlt={ogImageAlt}
            canonicalUrl={canonicalUrl ?? Astro.url.href}
        />
    </head>
    <body class=`${className} bg-background text-foreground selection:bg-foreground selection:text-primary-foreground overflow-x-hidden`>
        <Header />
        <main class="w-full">
            <slot />
        </main>
        <Footer />
    </body>
</html>
